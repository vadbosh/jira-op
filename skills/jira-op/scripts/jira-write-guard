#!/usr/bin/env python3
"""jira-write-guard — refuse a Jira write that the human has not approved.

PreToolUse hook for Bash (Claude Code, Codex) and the backend of the Opencode
plugin. It lets a command through unless the command WRITES to Jira; a write
passes only when both hold:

  1. the last message the human TYPED is an approval — "да", "утверждаю",
     "создавай", "согласен", "yes", "approve" — the whole message, nothing else;
  2. the last assistant reply before it — after the previous human message,
     slash command or interrupt — ENDS with the marker line
     `Утверждаешь? (да/нет)` (or `Approve? (yes/no)`), i.e. a draft was shown
     and the turn ended on the question.

An answer picked in a question dialog (AskUserQuestion) is a tool result, not a
typed message, and never counts: on 2026-10-01 a ticket was created right after
the four field questions were answered, while the draft sat unread behind the
dialog. Every write of the same turn after one "да" passes — create, sprint,
end date, transition, comment. A delete or a sprint close (`jira issue delete`,
`jira sprint close`, HTTP DELETE) passes only when the approved reply names each
issue key or sprint id it touches, and the command names them literally. A
create (`jira issue create|clone`, `jira epic create`, a write to
/rest/api/<v>/issue) passes only when the approved reply is its draft: it has
the `Summary:` and `Description:` lines, and the summary the command sends —
from `-s`, a JSON body, an `@file` or `jq --arg summary` — is in it.

What is a write. For jira-cli, everything except a known read (an allowlist
taken from `jira --help` of 1.7.0): a new verb or alias is refused until it is
listed, never let through. For curl, wget, httpie and xh aimed at `/rest/api/`,
`/rest/agile/` or an Atlassian host: PUT, PATCH, DELETE, or POST/a request body,
except a POST search. Heredoc bodies are data; `$( )`, backticks and `sh -c`
strings are commands. Not seen: a write made from a script file or from another
language (`python3 -c`, `node -e`).

Input (stdin, JSON): the hook payload. `tool_input.command` is the command;
the conversation comes from `transcript_path` (Claude Code or Codex JSONL) or,
from the Opencode plugin, from `messages`: [{"role": "user"|"assistant", "text": …}].

Exit 0 — allowed. Exit 2 — refused; the reason is on stderr, which every
assistant shows to the model. A write with no readable conversation is refused,
and so is a write the guard fails on: it does not wave writes through blind.
"""
import json
import os
import re
import shlex
import sys

APPROVALS = {"да", "утверждаю", "создавай", "согласен", "yes", "approve", "approved"}
MARKERS = ("утверждаешь? (да/нет)", "approve? (yes/no)")

REASON = (
    "jira-write-guard: this command writes to Jira, and the human has not approved it.\n"
    "Show the full draft (or the before/after of the change), end the message with the line\n"
    "    Утверждаешь? (да/нет)\n"
    "and stop. Run the write only after the human types «да». An answer picked in a question\n"
    "dialog does not count, and neither do answers about story points, sprint or dates."
)
DRAFT_REASON = (
    "jira-write-guard: this command creates a ticket, and the approved reply is not its\n"
    "draft: {}. Print the whole draft — Summary, Type, Sprint, Points, End Date,\n"
    "Description, Potential Risks, Acceptance Test — with the summary exactly as the\n"
    "command sends it, end the message with\n"
    "    Утверждаешь? (да/нет)\n"
    "and stop. No ticket is created without a draft the human has read."
)
DESTRUCTIVE_REASON = (
    "jira-write-guard: this command deletes an issue or closes a sprint, and the approved\n"
    "draft does not name {}. A «да» covers a delete or a sprint close only when the draft\n"
    "names every issue key or sprint id, and the command names them literally — no\n"
    "variables, no loops. Show a draft that names them, end it with\n"
    "    Утверждаешь? (да/нет)\n"
    "and stop."
)

# --- what counts as a Jira write --------------------------------------------

# Anything that names Jira at all. The Opencode plugin pre-filters with the same
# pattern; tests/test_write_guard.sh checks that the two agree.
MENTION = re.compile(r"\bjira\b|/rest/(?:api|agile)/|atlassian\.(?:net|com)", re.I)

# jira-cli 1.7.0 reads, from `jira --help` and `jira <group> --help`.
JIRA_READ_TOP = {"open", "me", "serverinfo", "version", "help", "init", "man", "completion"}
JIRA_GROUPS = {"issue", "issues", "sprint", "sprints", "epic", "epics", "board", "boards",
               "project", "projects", "release", "releases"}
JIRA_READ_VERBS = {"list", "lists", "ls", "search", "view", "show"}
JIRA_VALUE_FLAGS = {"-c", "--config", "-p", "--project"}
HELP_FLAGS = {"-h", "--help"}
# Writes no «да» covers blindly: the approved draft must name every target (D3).
JIRA_DESTRUCTIVE = {("issue", v) for v in ("delete", "remove", "rm", "del")} | \
                   {("sprint", v) for v in ("close", "complete")}
# Writes that make a new ticket: the approved reply must be its draft.
JIRA_CREATE = {("issue", "create"), ("issue", "clone"), ("epic", "create")}
CREATE_URL = re.compile(r"/rest/api/[^/]+/issue(?:/bulk)?/?(?:[?#]|$)", re.I)
DRAFT_LABELS = (re.compile(r"(?im)^[\s>*_`#-]*(?:summary|заголовок)[*_`]*\s*:"),
                re.compile(r"(?im)^[\s>*_`#-]*(?:description|описание)[*_`]*\s*:"))

# Words that start a command without being it.
SHELL_KEYWORDS = {"if", "then", "else", "elif", "while", "until", "do", "{", "!"}
# Wrappers run the command after their options; the set lists options taking a value.
WRAPPERS = {
    "rtk": set(), "nohup": set(), "command": set(), "builtin": set(), "chronic": set(),
    "time": {"-f", "-o"},
    "exec": {"-a"},
    "sudo": {"-u", "-g", "-C", "-D", "-h", "-p", "-r", "-t", "-T", "-U"},
    "env": {"-u", "-C", "-S", "--unset", "--chdir", "--split-string"},
    "nice": {"-n", "--adjustment"},
    "timeout": {"-s", "-k", "--signal", "--kill-after"},
    "xargs": {"-a", "-d", "-E", "-I", "-L", "-n", "-P", "-s", "--arg-file", "--delimiter",
              "--max-args", "--max-lines", "--max-procs", "--max-chars"},
    "stdbuf": {"-i", "-o", "-e"},
    "ionice": {"-c", "-n", "-p"},
}
SHELLS = {"bash", "sh", "zsh", "dash", "ksh"}

HTTP_CLIENTS = {"curl", "wget", "http", "https", "xh", "xhs"}
JIRA_URL = re.compile(r"/rest/(?:api|agile)/|atlassian\.(?:net|com)", re.I)
# Jira search takes its JQL in a POST body and still only reads.
SEARCH_URL = re.compile(r"/rest/api/[^/]+/search(?:/jql)?/?(?:[?#]|$)", re.I)
WRITE_METHODS = {"PUT", "PATCH", "DELETE"}
READ_METHODS = {"GET", "HEAD", "OPTIONS"}
CURL_VALUE = set("AbcCdDeEFHKmoPQrTtuUwxXyYz")  # curl short options that take a value
CURL_BODY = ("--data", "--json", "--form", "--upload-file")
WGET_BODY = {"--post-data", "--post-file", "--body-data", "--body-file"}
HTTPIE_VALUE = {"-a", "--auth", "-A", "--auth-type", "-o", "--output", "-p", "--print",
                "--session", "--session-read-only", "--verify", "--cert", "--cert-key",
                "--proxy", "--timeout", "--pretty", "-s", "--style", "--format-options",
                "--max-redirects", "--default-scheme", "--boundary"}
HTTPIE_ITEM = re.compile(r"^[^\s=:@]+(?::=@?|=@?|@)(?!=)")  # k=v, k:=json, k@file — a body

HEREDOC = re.compile(r"(?<!<)<<(?!<)(-?)\s*\\?([\"']?)([A-Za-z0-9_.-]+)\2")
MAX_DEPTH = 5


def _strip_heredocs(cmd):
    """Drop heredoc bodies: they are data, not commands.

    The line carrying `<<WORD` stays, the lines up to the line `WORD` go. A
    heredoc with no terminating line is left whole, so a stray `<<` (inside
    quotes, or `$((1<<2))`) cannot hide the commands that follow it.
    """
    lines = cmd.split("\n")
    out, i = [], 0
    while i < len(lines):
        line = lines[i]
        out.append(line)
        i += 1
        for m in HEREDOC.finditer(line):
            word, tabs = m.group(3), m.group(1) == "-"
            end = next((j for j in range(i, len(lines))
                        if (lines[j].lstrip("\t") if tabs else lines[j]).rstrip("\r") == word),
                       None)
            if end is None:
                break
            i = end + 1
    return "\n".join(out)


def _substitutions(cmd):
    """Bodies of `…` and $(…) outside single quotes: bash runs them as commands."""
    out, i, n = [], 0, len(cmd)
    single = double = False
    while i < n:
        c = cmd[i]
        if c == "\\" and not single:
            i += 2
            continue
        if c == "'" and not double:
            single = not single
        elif c == '"' and not single:
            double = not double
        elif not single and c == "`":
            j = i + 1
            while j < n and cmd[j] != "`":
                j += 2 if cmd[j] == "\\" else 1
            out.append(cmd[i + 1:j])
            i = j
        elif not single and cmd.startswith("$(", i) and not cmd.startswith("$((", i):
            depth, j = 1, i + 2
            while j < n and depth:
                depth += {"(": 1, ")": -1}.get(cmd[j], 0)
                j += 1
            out.append(cmd[i + 2:j - 1 if depth == 0 else j])
            i = j - 1
        i += 1
    return out


def _segments(cmd):
    """Split a shell command into simple commands at ; && || | and newlines.

    Raises ValueError when the quoting does not parse (an unbalanced quote).
    """
    out, cur = [], []
    lex = shlex.shlex(cmd, posix=True, punctuation_chars=";&|()\n")
    lex.whitespace = " \t\r"
    lex.whitespace_split = True
    for tok in lex:
        if tok and set(tok) <= set(";&|()\n"):
            if cur:
                out.append(cur)
            cur = []
        else:
            cur.append(tok)
    if cur:
        out.append(cur)
    return out


def _strip_prefix(words):
    """Drop VAR=value assignments, shell keywords and wrappers with their options."""
    i = 0
    while i < len(words):
        w = words[i]
        if re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", w) or w in SHELL_KEYWORDS:
            i += 1
        elif w in WRAPPERS:
            takes = WRAPPERS[w]
            i += 1
            while i < len(words) and words[i].startswith("-"):
                opt = words[i]
                i += 1
                if opt == "--":
                    break
                if opt in takes:
                    i += 1
            if w == "timeout":
                i += 1  # the duration
        else:
            break
    return words[i:]


def _dash_c(args):
    """The script string of `bash -c '…'`, or None."""
    k = 0
    while k < len(args):
        w = args[k]
        if w in ("-o", "-O", "+o", "+O"):
            k += 2
            continue
        if not w.startswith("-") or w.startswith("--"):
            return None
        if "c" in w[1:]:
            return args[k + 1] if k + 1 < len(args) else None
        k += 1
    return None


def _targets(words):
    """The targets a destructive command names; () when one is not literal."""
    if not words or any(re.search(r"[$`*?{}\[\]<>]", w) for w in words):
        return ()
    return tuple(words)


def _flag_value(args, short, long):
    for k, w in enumerate(args):
        if w in (short, long):
            return args[k + 1] if k + 1 < len(args) else None
        if w.startswith(long + "="):
            return w[len(long) + 1:]
        if w.startswith(short) and not w.startswith("--") and len(w) > len(short):
            return w[len(short):]
    return None


def _jira_verdict(args):
    """(write, destructive, create) for jira-cli; a write unless a known read.

    destructive is None, or the targets of a delete or a sprint close. create
    is None, or (summary, False) for a command that makes a ticket.
    """
    before_dashes = args[:args.index("--")] if "--" in args else args
    if HELP_FLAGS & set(before_dashes):
        return False, None, None  # `jira issue create --help` prints usage
    pos, k = [], 0
    while k < len(args):
        w = args[k]
        if w in JIRA_VALUE_FLAGS:
            k += 2
            continue
        if not w.startswith("-"):
            pos.append(w)
        k += 1
    if not pos or pos[0] in JIRA_READ_TOP:
        return False, None, None
    if pos[0] not in JIRA_GROUPS:
        return True, None, None
    if len(pos) < 2 or pos[1] in JIRA_READ_VERBS:
        return False, None, None
    action = (pos[0].rstrip("s"), pos[1])
    if action in JIRA_DESTRUCTIVE:
        return True, _targets(pos[2:]), None
    if action in JIRA_CREATE:
        return True, None, (_flag_value(args, "-s", "--summary"), False)
    return True, None, None


def _body_summary(prog, args):
    """(summary, from_file) of a REST create's body, or (None, False)."""
    if prog in ("http", "https", "xh", "xhs"):
        for w in args:
            if w.startswith("summary="):
                return w[len("summary="):], False
        return None, False
    body = None
    for k, w in enumerate(args):
        name, eq, val = w.partition("=")
        if name in ("-d", "--data", "--data-raw", "--data-binary", "--data-ascii", "--json",
                    "--post-data", "--body-data", "--post-file", "--body-file"):
            body = val if eq else _next(args, k)
            if name in ("--post-file", "--body-file"):
                body = "@" + body
        elif w.startswith("-d") and not w.startswith("--") and len(w) > 2:
            body = w[2:]
    if not body:
        return None, False
    from_file = body.startswith("@")
    if from_file:
        path = os.path.expanduser(body[1:])
        if body[1:] in ("", "-") or not os.path.isfile(path):
            return None, True
        with open(path, encoding="utf-8", errors="replace") as fh:
            body = fh.read(1 << 20)
    try:
        doc = json.loads(body)
    except ValueError:
        return None, from_file
    fields = (doc.get("fields") or (doc.get("issueUpdates") or [{}])[0].get("fields")
              if isinstance(doc, dict) else None)
    s = fields.get("summary") if isinstance(fields, dict) else None
    return (s if isinstance(s, str) else None), from_file


def _next(args, k):
    return args[k + 1] if k + 1 < len(args) else ""


def _http_verdict(prog, args):
    """(write, destructive, create) for an HTTP client: destructive is set for
    DELETE, create for a write to /rest/api/<v>/issue."""
    urls = [w for w in args if JIRA_URL.search(w)]
    if not urls:
        return False, None, None
    write = _http_is_write(prog, args, urls)
    if write == "DELETE":
        last = [re.split(r"[?#]", u)[0].rstrip("/").rsplit("/", 1)[-1] for u in urls]
        return True, _targets(last), None
    if write and any(CREATE_URL.search(u) for u in urls):
        return True, None, _body_summary(prog, args)
    return bool(write), None, None


def _http_is_write(prog, args, urls):
    """False, True, or "DELETE"."""
    method, body = None, False
    if prog == "curl":
        for k, w in enumerate(args):
            if w.startswith("--"):
                name, _, val = w.partition("=")
                if name == "--request":
                    method = (val or _next(args, k)).upper()
                elif name == "--get":
                    method = method or "GET"
                elif name.startswith(CURL_BODY):
                    body = True
            elif w.startswith("-") and len(w) > 1:
                # A short-option cluster: -sd @f, -sXDELETE, -sF file=@a
                for p, ch in enumerate(w[1:], 1):
                    if ch == "X":
                        method = (w[p + 1:] or _next(args, k)).upper()
                        break
                    if ch == "G":
                        method = method or "GET"
                    if ch in "dFT":
                        body = True
                    if ch in CURL_VALUE:
                        break
    elif prog == "wget":
        for k, w in enumerate(args):
            name, _, val = w.partition("=")
            if name == "--method":
                method = (val or _next(args, k)).upper()
            elif name in WGET_BODY:
                body = True
    else:  # httpie, xh: [options] [METHOD] URL [items]
        pos, k = [], 0
        while k < len(args):
            w = args[k]
            if w in HTTPIE_VALUE:
                k += 2
                continue
            if w == "--raw" or w.startswith(("--raw=", "<")):
                body = True
            elif not w.startswith("-"):
                pos.append(w)
            k += 1
        if pos and pos[0].upper() in WRITE_METHODS | READ_METHODS | {"POST"}:
            method = pos.pop(0).upper()
        if any(HTTPIE_ITEM.match(w) for w in pos[1:]):
            body = True
    if method == "DELETE":
        return "DELETE"
    if method in WRITE_METHODS:
        return True
    if method in READ_METHODS:
        return False
    if all(SEARCH_URL.search(u) for u in urls):
        return False  # POST with a JQL body to search/ is a read
    return method == "POST" or body


def _scan(cmd, depth, ctx):
    """True if cmd writes to Jira. Every segment is read, not only up to the
    first write: ctx collects the targets of each delete or sprint close, the
    summary of each create, and a `jq --arg summary` that builds a create body."""
    destructive = ctx["destructive"]
    if not MENTION.search(cmd):
        return False
    cmd = _strip_heredocs(cmd)
    cmd = re.sub(r"\\\r?\n", " ", cmd)  # a `\`-continued line is one command
    write = False
    if depth < MAX_DEPTH:
        for sub in _substitutions(cmd):
            write |= _scan(sub, depth + 1, ctx)
    try:
        segments = _segments(cmd)
    except ValueError:
        # Unparsable quoting: the segments cannot be trusted, so any mention of
        # Jira counts as a write rather than judging the first word alone.
        if not MENTION.search(cmd):
            return write
        if re.search(r"\b(?:delete|del|rm|remove|close|complete)\b", cmd, re.I):
            destructive.append(())
        if re.search(r"\b(?:create|clone)\b|/issue\b", cmd, re.I):
            ctx["creates"].append((None, False))
        return True
    for seg in segments:
        words = _strip_prefix(seg)
        if not words:
            continue
        prog = words[0].rsplit("/", 1)[-1]
        verdict = (False, None, None)
        if prog in SHELLS:
            script = _dash_c(words[1:])
            if script is not None and depth < MAX_DEPTH:
                write |= _scan(script, depth + 1, ctx)
        elif prog == "jira":
            verdict = _jira_verdict(words[1:])
        elif prog in HTTP_CLIENTS:
            verdict = _http_verdict(prog, words[1:])
        elif prog == "jq":
            s = _jq_arg(words[1:], "summary")
            if s is not None:
                ctx["jq_summary"] = s
        write |= verdict[0]
        if verdict[1] is not None:
            destructive.append(verdict[1])
        if verdict[2] is not None:
            ctx["creates"].append(verdict[2])
    return write


def _jq_arg(args, name):
    for k in range(len(args) - 2):
        if args[k] == "--arg" and args[k + 1] == name:
            return args[k + 2]
    return None


def classify(cmd):
    """(write, destructive, creates).

    destructive holds, per delete or sprint close, the targets it names — ()
    when a target is a variable or otherwise not literal. creates holds, per
    command that makes a ticket, the summary it sends, or None when the guard
    cannot see it.
    """
    ctx = {"destructive": [], "creates": [], "jq_summary": None}
    write = _scan(cmd, 0, ctx)
    # A body file written by jq in the same command does not exist yet, or is
    # the previous one: the jq argument is what will be sent.
    creates = [ctx["jq_summary"] if ctx["jq_summary"] is not None and (s is None or from_file)
               else s for s, from_file in ctx["creates"]]
    return write, ctx["destructive"], creates


def is_jira_write(cmd):
    return classify(cmd)[0]


# --- reading the conversation -----------------------------------------------

# User entries that are not typed by the human.
SKIP_PREFIXES = ("<command-", "<local-command", "<system-reminder", "# agents.md instructions",
                 "<environment_context", "<user_instructions", "[request interrupted")
# Of those, the ones the human caused: they still close the window of a draft.
BOUNDARY_PREFIXES = ("<command-", "<local-command", "[request interrupted")


def _text_of(content, kinds):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(str(c.get("text", "")) for c in content
                         if isinstance(c, dict) and c.get("type") in kinds)
    return ""


def _from_transcript(path):
    """[(role, text)] for human messages and assistant text, in order."""
    events = []
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if not isinstance(e, dict):
                continue
            # Claude Code
            if e.get("type") in ("user", "assistant") and isinstance(e.get("message"), dict):
                msg = e["message"]
                if e["type"] == "user":
                    content = msg.get("content")
                    if e.get("isMeta") or (isinstance(content, list) and
                                           any(isinstance(c, dict) and c.get("type") == "tool_result"
                                               for c in content)):
                        continue  # tool results, dialog answers, injected text
                    events.append(("user", _text_of(content, ("text",))))
                else:
                    t = _text_of(msg.get("content"), ("text",))
                    if t:
                        events.append(("assistant", t))
                continue
            # Codex rollout
            p = e.get("payload") if e.get("type") == "response_item" else None
            if isinstance(p, dict) and p.get("type") == "message":
                if p.get("role") == "user":
                    events.append(("user", _text_of(p.get("content"), ("input_text",))))
                elif p.get("role") == "assistant":
                    t = _text_of(p.get("content"), ("output_text",))
                    if t:
                        events.append(("assistant", t))
    return events


def _norm(text):
    return re.sub(r"[\s.!,;:)(]+$", "", text.strip().lower()).strip()


def approved(events):
    return approved_reply(events) is not None


def approved_reply(events):
    """The reply the human approved with a typed «да», or None."""
    def lead(t):
        return t.strip().lower()

    typed = [i for i, (r, t) in enumerate(events)
             if r == "user" and t.strip() and not lead(t).startswith(SKIP_PREFIXES)]
    if not typed:
        return None
    last = typed[-1]
    if _norm(events[last][1]) not in APPROVALS:
        return None
    prev = max((i for i in range(last) if events[i][0] == "user" and
                (i in typed or lead(events[i][1]).startswith(BOUNDARY_PREFIXES))), default=-1)
    replies = [t for r, t in events[prev + 1:last] if r == "assistant" and t.strip()]
    if not replies:
        return None
    tail = replies[-1].rstrip().rstrip("*_`").rstrip().lower()
    return replies[-1] if tail.endswith(MARKERS) else None


def _flat(text):
    return " ".join(text.split()).casefold()


def undrafted(creates, reply):
    """Why the approved reply is not the draft of the tickets being created."""
    if not creates:
        return []
    problems = []
    if not all(p.search(reply) for p in DRAFT_LABELS):
        problems.append("it has no Summary: and Description: lines")
    for s in creates:
        if s is not None and not re.search(r"[$`<]", s) and _flat(s) not in _flat(reply):
            problems.append(f"the summary «{s}» that the command sends is not in it")
    return problems


def unnamed(destructive, reply):
    """Targets of a delete or sprint close that the approved reply does not name."""
    missing = []
    for targets in destructive:
        if not targets:
            missing.append("(a target given by a variable, a loop or a pattern)")
        missing += [t for t in targets
                    if not re.search(r"(?<![\w-])" + re.escape(t) + r"(?![\w-])", reply, re.I)]
    return missing


def _events(payload):
    if isinstance(payload.get("messages"), list):
        return [(m.get("role"), m.get("text") if isinstance(m.get("text"), str) else "")
                for m in payload["messages"] if isinstance(m, dict)]
    if payload.get("transcript_path"):
        try:
            return _from_transcript(payload["transcript_path"])
        except OSError:
            return []
    return []


def main():
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        return 0  # not a hook payload: nothing to judge
    if not isinstance(payload, dict):
        return 0
    ti = payload.get("tool_input")
    cmd = ti.get("command") if isinstance(ti, dict) else ti
    if not isinstance(cmd, str):
        return 0
    reason = REASON
    try:
        write, destructive, creates = classify(cmd)
        if not write:
            return 0
        reply = approved_reply(_events(payload))
        if reply is not None:
            problems = undrafted(creates, reply)
            missing = unnamed(destructive, reply)
            if not problems and not missing:
                return 0
            reason = (DRAFT_REASON.format("; ".join(problems)) if problems
                      else DESTRUCTIVE_REASON.format(", ".join(missing)))
    except Exception:  # noqa: BLE001 — a guard that fails on a write refuses it
        pass
    print(reason, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
